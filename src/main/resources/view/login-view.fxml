<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="14.0" styleClass="login-pane"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.netjags.catalogobiblioteca.digital.controller.LoginController"
      prefWidth="420.0" prefHeight="440.0">
    <padding>
        <Insets top="40.0" bottom="40.0" left="50.0" right="50.0"/>
    </padding>

    <Label styleClass="titulo-app" text="Biblioteca Universitaria"/>
    <Label styleClass="subtitulo-app" text="Catalogo Bibliografico Digital"/>

    <VBox spacing="6.0" alignment="CENTER_LEFT">
        <Label text="Usuario" styleClass="etiqueta-form"/>
        <TextField fx:id="txtUsuario" promptText="Ingrese su usuario"/>
    </VBox>

    <VBox spacing="6.0" alignment="CENTER_LEFT">
        <Label text="Contrasenia" styleClass="etiqueta-form"/>
        <PasswordField fx:id="txtPassword" promptText="Ingrese su contrasenia"/>
    </VBox>

    <Button text="Ingresar" defaultButton="true" styleClass="boton-primario" maxWidth="Infinity" onAction="#iniciarSesion"/>

    <Label fx:id="lblMensaje" styleClass="mensaje-error" wrapText="true"/>
</VBox>
